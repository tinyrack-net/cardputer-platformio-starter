# M5Stack Cardputer (ESP32-S3FN8: 8 MB flash, no PSRAM)
# Mirrors the settings of the upstream M5Cardputer-UserDemo sdkconfig
# (ESP-IDF v4.4.6) on top of the ESP-IDF defaults for the esp32s3 target.

# Flash size (default is 2 MB) and the upstream custom partition table
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Peripherals used by the demo: BLE HID keyboard, 160 MHz CPU, 1 kHz tick
CONFIG_BT_ENABLED=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_160=y
CONFIG_FREERTOS_HZ=1000

# Console: UART0 primary + USB Serial/JTAG secondary (as upstream)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# C++ exceptions are used by the IR app
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0

# The demo's app_main runs the whole framework (upstream also raised this)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8000

# Upstream ships with the task watchdog disabled
CONFIG_ESP_TASK_WDT=n

# Wi-Fi / BLE settings as in the upstream sdkconfig
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BT_BTU_TASK_STACK_SIZE=4096

# TinyUSB source component: keep the driver selection the upstream build used
CONFIG_USING_SYNOPSYS_DWC2_DRIVER=n

# USB HID device example options (main/Kconfig.projbuild)
CONFIG_SUBCLASS_KEYBOARD=y
CONFIG_TUSB_VID=0x303A
CONFIG_TUSB_PID=0x8000
CONFIG_TUSB_MANUFACTURER="Espressif"
CONFIG_TUSB_PRODUCT="M5-Cardputer"
